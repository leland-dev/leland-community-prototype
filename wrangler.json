{
	"name": "leland-community-prototype",
	"main": "worker/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application"
	},
	"kv_namespaces": [
		{
			"binding": "AGENTS_KV",
			"id": "1b0b50a958444a77954bd190cbf4f5d1"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "IDEA_JAR", "class_name": "IdeaJar" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["IdeaJar"] }],
	"vars": { "ADMIN_KEY": "Q4ROCKS" }
}